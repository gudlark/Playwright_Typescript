{
  "name": "playwright-typescript-allure-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright TypeScript test framework with Allure reporting and Excel-driven test data",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report:generate": "allure generate allure-results --clean --output allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.30",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0",
    "typescript": "^5.8.3",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
